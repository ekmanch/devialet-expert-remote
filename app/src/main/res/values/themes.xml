<resources>
    <!-- Not DayNight on purpose: the redesign is a fixed dark, copper-accented
         palette tied to the amp's own hardware finish, not something that
         should flip to a light theme under system settings. -->
    <style name="Theme.DevialetRemote" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/color_surface</item>
        <item name="colorPrimaryDark">@color/color_page</item>
        <item name="colorAccent">@color/color_copper_bright</item>
        <item name="android:windowBackground">@color/color_page</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:textColorSecondary">@color/color_text_dim</item>
    </style>
</resources>
