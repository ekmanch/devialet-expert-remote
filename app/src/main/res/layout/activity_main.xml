<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content. Spacing is tightened deliberately so most phones show
         this without scrolling, but it stays inside a ScrollView (fillViewport
         so it still stretches to fill a tall screen) rather than a fixed
         layout - on a short/small-density screen it scrolls instead of
         clipping controls off the bottom. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_page"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wordmark"
                android:textColor="@color/color_copper_bright"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                android:fontFamily="@font/space_grotesk_semibold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="@string/title_app"
                android:textColor="@color/color_text"
                android:textSize="22sp"
                android:fontFamily="@font/space_grotesk_semibold" />

            <!-- Device card -->
            <LinearLayout
                android:id="@+id/deviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp">

                <View
                    android:id="@+id/deviceDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_disconnected" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_none_selected"
                        android:textColor="@color/color_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDeviceSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/device_tap_to_choose"
                        android:textColor="@color/color_text_dim"
                        android:textSize="12.5sp"
                        android:fontFamily="@font/jetbrains_mono_regular" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/device_change"
                    android:textColor="@color/color_text_faint"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Volume -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="14dp"
                android:text="@string/label_volume" />

            <FrameLayout
                android:layout_width="178dp"
                android:layout_height="178dp"
                android:layout_gravity="center_horizontal">

                <com.christian.devialetremote.VolumeDialView
                    android:id="@+id/volumeDial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/label_volume" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/txtVolumeDb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_db_default"
                        android:textColor="@color/color_copper_bright"
                        android:textSize="27sp"
                        android:fontFamily="@font/jetbrains_mono_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/dial_unit_db"
                        android:textColor="@color/color_text_dim"
                        android:textSize="11sp"
                        android:fontFamily="@font/jetbrains_mono_regular" />

                    <TextView
                        android:id="@+id/txtDialSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/dial_no_source"
                        android:textColor="@color/color_text_faint"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="@font/space_grotesk_medium" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="@string/btn_vol_down"
                    android:textColor="@color/color_text"
                    android:textSize="20sp"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:text="@string/btn_vol_up"
                    android:textColor="@color/color_text"
                    android:textSize="20sp"
                    android:fontFamily="@font/space_grotesk_semibold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Sound & Room -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="14dp"
                android:text="@string/label_sound_room" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="12dp">

                    <!-- Tapping the name/state opens the SAM level drawer;
                         the switch itself only flips SAM on/off - same split
                         we settled on in the mockup, so the level control
                         stays out of the way until you actually want it. -->
                    <LinearLayout
                        android:id="@+id/samOpenTarget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        tools:ignore="NestedWeights">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/toggle_sam_name"
                                android:textColor="@color/color_text"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/toggle_chevron"
                                android:textColor="@color/color_text_faint"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtSamState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sam_state_on_format"
                            android:textColor="@color/color_text_faint"
                            android:textSize="11sp"
                            android:fontFamily="@font/jetbrains_mono_regular" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/samSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        tools:ignore="NestedWeights">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_night_name"
                            android:textColor="@color/color_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNightState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/state_off"
                            android:textColor="@color/color_text_faint"
                            android:textSize="11sp"
                            android:fontFamily="@font/jetbrains_mono_regular" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/nightSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:trackTint="@color/switch_track_tint"
                        app:thumbTint="@color/switch_thumb_tint" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mute / Power -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/btnMute"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgMuteIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_mute"
                        android:contentDescription="@string/btn_mute" />

                    <TextView
                        android:id="@+id/txtMuteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_mute"
                        android:textColor="@color/color_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPower"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgPowerIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_power"
                        android:contentDescription="@string/btn_power_off" />

                    <TextView
                        android:id="@+id/txtPowerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_power_off"
                        android:textColor="@color/color_text"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Source -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="14dp"
                android:text="@string/label_source" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sourceTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txtTriggerIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/shape_source_icon"
                        android:gravity="center"
                        android:text="@string/source_icon_default"
                        android:textColor="@color/color_copper_bright"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/source_active_label"
                            android:textColor="@color/color_text_faint"
                            android:textSize="12sp"
                            android:fontFamily="@font/jetbrains_mono_regular" />

                        <TextView
                            android:id="@+id/txtTriggerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dial_no_source"
                            android:textColor="@color/color_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtSourceChevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/source_chevron"
                        android:textColor="@color/color_text_faint"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sourceListWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/sourcesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SAM level drawer - slides in from the end (right in LTR) edge,
         opened by tapping the SAM card's name/state, not the switch. -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/color_surface"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sam_drawer_eyebrow"
            android:textColor="@color/color_copper_bright"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:fontFamily="@font/space_grotesk_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sam_drawer_title"
            android:textColor="@color/color_text"
            android:textSize="24sp"
            android:fontFamily="@font/space_grotesk_semibold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sam_drawer_desc"
            android:textColor="@color/color_text_dim"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sam_drawer_level_label"
                    android:textColor="@color/color_text_dim"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/txtSamLevelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sam_drawer_level_value_format"
                    android:textColor="@color/color_copper_bright"
                    android:textSize="16sp"
                    android:fontFamily="@font/jetbrains_mono_semibold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekSamLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="70"
                android:progressTint="@color/color_copper_bright"
                android:progressBackgroundTint="@color/color_surface_3"
                android:thumbTint="@color/color_copper_bright" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSamDrawerDone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/sam_drawer_done"
            android:textColor="@color/color_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
